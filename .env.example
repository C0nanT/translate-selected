# copy to .env and fill in (.env is git-ignored); see README "Translation provider"
# google (default, free, no key) | deepl | google-cloud
TRANSLATOR_PROVIDER=
# used when TRANSLATOR_PROVIDER=deepl (free keys end in :fx)
DEEPL_API_KEY=
# used when TRANSLATOR_PROVIDER=google-cloud
GOOGLE_TRANSLATE_API_KEY=
